    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.9.0",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.0.18",
    "typescript": "^5.4.0",
    "vitest": "^4.0.18"
  },
  "private": true
}
